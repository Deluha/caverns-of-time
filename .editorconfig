# Editor settings: Python and SQL indent 4, YAML and JSON indent 2, LF line ends, a final newline.
# The line length lives in pyproject.toml ([tool.ruff]).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{yml,yaml,json}]
indent_size = 2

# Markdown keeps trailing double-space line breaks; its indent is its own (lists wrap at 3).
[*.md]
trim_trailing_whitespace = false
indent_size = unset
